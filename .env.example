# ---------------------------------------------------------------------------
# Prism Studio — example environment configuration
#
# Copy this file to `.env` and replace every placeholder value with the real
# configuration for your environment. NEVER commit a populated `.env` file.
#
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
# Port the Express API binds to (assigned by the deploy script; 4112 in prod).
PORT=4112

# Node environment: development | production
NODE_ENV=production

# --- TLS -------------------------------------------------------------------
# When 'true' the API terminates TLS itself using the cert/key paths below.
# Set to 'false' for plain HTTP during local development.
SSL_ENABLED=true

# Absolute path to the TLS certificate file.
SSL_CERT_PATH=/home/arx-app/backends/certs/certificate.crt

# Absolute path to the TLS private key file.
SSL_KEY_PATH=/home/arx-app/backends/certs/private.key

# Optional absolute path to a CA chain file. Leave empty if not required.
SSL_CA_PATH=/home/arx-app/backends/certs/ca_bundle.crt

# --- Database (MySQL) ------------------------------------------------------
# Load the schema and seed data first:
#   mysql -u "$DB_USER" -p "$DB_NAME" < schema.sql
#   mysql -u "$DB_USER" -p "$DB_NAME" < seed.sql
DB_HOST=localhost
DB_USER=designstudio_user
DB_PASSWORD=replace-with-your-database-password
DB_NAME=designstudio

# --- Sessions --------------------------------------------------------------
# Secret used to sign the session cookie. Use a long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-session-secret

# Cookie domain so the session cookie is shared between the site and API
# subdomains. Leave empty to scope the cookie to the API host only.
SESSION_COOKIE_DOMAIN=.arx-app.com

# --- CORS ------------------------------------------------------------------
# Domain suffix allowed by CORS (permits all *.arx-app.com origins).
CORS_ALLOWED_ORIGIN_SUFFIX=.arx-app.com

# --- Frontend (public, exposed to the browser) -----------------------------
# Public base URL of the Express API used by the browser at runtime.
NEXT_PUBLIC_API_BASE_URL=https://designstudio-api.arx-app.com:4112